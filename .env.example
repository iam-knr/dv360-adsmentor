# Copy to .env.local for local work. Values below are safe local placeholders.
# NEVER commit real values. The repo is public. Production values live only in Vercel (build-plan 1.10).

# Database: local embedded Postgres (npm run db:local, port 54329)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54329/dv360_dev"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54329/dv360_dev"
DATABASE_URL_TEST="postgresql://postgres:postgres@127.0.0.1:54329/dv360_test"
# Production (set in Vercel only), Supabase pooled runtime URL, then direct URL:
#   DATABASE_URL="<supabase pooler string, port 6543>?pgbouncer=true&connection_limit=1"
#   DIRECT_URL="<supabase direct string, port 5432>"

# Auth.js
AUTH_SECRET="local-dev-secret-local-dev-secret-0000"
AUTH_TRUST_HOST="true"
# Local only, ignored when NODE_ENV=production
AUTH_DEV_BYPASS="1"

# Engine trigger: a GitHub Actions workflow POSTs to ENGINE_CRON_URL with Authorization: Bearer CRON_SECRET.
# In GitHub they are Actions secrets; the job stays off until the repo variable ENGINE_TICK_ENABLED=true.
CRON_SECRET="local-cron-secret"
ENGINE_CRON_URL="http://127.0.0.1:3000/api/sim/engine/tick"
# Cron mode: github (default on Vercel Hobby) or manual. Vercel cron is not used.
CRON_MODE="github"

# First Super admin created by npm run db:bootstrap (module 19, RC-071). Placeholders only.
SEED_SUPER_ADMIN_EMAIL="admin@example.test"
SEED_SUPER_ADMIN_PASSWORD="change-me-locally"
SEED_SUPER_ADMIN_NAME="Local Admin"

# Component gallery (Preview only, never Production)
ENABLE_GALLERY="1"

# Uploads (Phase 4), added by Vercel Blob
BLOB_READ_WRITE_TOKEN=""

# Playwright: set to use the preinstalled Chromium, e.g. /opt/pw-browsers/chromium-1243/chrome-linux/chrome
PLAYWRIGHT_CHROMIUM_PATH=""
# Optional: run e2e against a deployed URL; bypass header for protected previews
E2E_BASE_URL=""
VERCEL_AUTOMATION_BYPASS_SECRET=""
