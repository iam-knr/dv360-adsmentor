{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run vercel-build",
  "ignoreCommand": "bash scripts/vercel-ignore.sh",
  "regions": ["bom1"],
  "git": {
    "deploymentEnabled": {
      "p4-*": false,
      "p5-*": false,
      "p6-*": false,
      "docs/*": false
    }
  }
}
