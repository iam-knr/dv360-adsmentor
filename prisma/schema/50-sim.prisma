  exchangeId               String?
  deviceType               DeviceType?
  environment              Environment?
  regionCode               String?
  creativeId               String?
  adGroupId                String?
  dealId                   String?
  bidRequests              BigInt       @default(0)
  eligibleRequests         BigInt       @default(0)
  bidsSubmitted            BigInt       @default(0)
  bidResponses             BigInt       @default(0)
  impressions              BigInt       @default(0)
